@model HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.LanguageRequest

<section class="page-section">
    <div class="content-card">

        <div class="section-head">
            <h2>Tạo ngôn ngữ</h2>
        </div>

        <form asp-area="Admin"
              asp-controller="Language"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="Name">Tên ngôn ngữ</label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Code">Mã ngôn ngữ</label>

                <input asp-for="Code"
                       class="form-control" />

                <span asp-validation-for="Code"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Mô tả</label>

                <input asp-for="Description"
                       class="form-control" />

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>
            <div class="form-actions">
                <a asp-area="Admin"
                   asp-controller="Language"
                   asp-action="Index"
                   class="btn">
                    Quay lại
                </a>
                <button type="submit"
                        class="btn btn-dark">
                    Tạo ngôn ngữ
                </button>
                <a asp-area="Admin"
                   asp-controller="Language"
                   asp-action="Index"
                   class="btn">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</section>