@model List<HeThongHocNgoaiNguTrucTuyen.Dtos.Responses.VocabularyInfoResponse>
@{
    int pageNumber = ViewBag.PageNumber ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
    var lessons = ViewBag.Lessons as List<HeThongHocNgoaiNguTrucTuyen.Dtos.Responses.LessonInfoResponse>;
}
@section Styles {
    <style>
        .muted {
            margin: 4px 0 0;
            color: #667085;
            font-size: 11px;
        }
        .vocabulary-actions {
            white-space: nowrap;
        }
        .vocabulary-word {
            font-weight: 600;
        }
        .example-cell {
            max-width: 250px;
            white-space: normal;
        }
    </style>
}
<section class="page-section">
    <div class="content-card">
        <div class="section-head">
            <div>
                <h2>Quản lý từ vựng</h2>
                <p class="muted">Quản lý từ vựng theo từng bài học</p>
            </div>
            <div class="toolbar">
                <form asp-area="Admin"
                      asp-controller="Vocabulary"
                      asp-action="Index"
                      method="get">
                    <div class="search-control">
                        <span>⌕</span>
                        <input type="text" name="word" value="@ViewBag.Word" placeholder="Tìm kiếm từ vựng..." />
                        <select name="lessonId" class="select-control">
                            <option value="">
                                -- Tất cả bài học --
                            </option>
                            @if (lessons != null)
                            {
                                foreach (var lesson in lessons)
                                {
                                    <option value="@lesson.LessonId" selected="@(ViewBag.LessonId != null && Convert.ToInt32(ViewBag.LessonId) == lesson.LessonId)">
                                        @lesson.Title
                                    </option>
                                }
                            }
                        </select>
                        <input type="hidden" name="pageSize" value="@pageSize" />
                        <button type="submit" class="btn-small">Tìm kiếm</button>
                    </div>
                </form>
                <a class="btn btn-dark"
                   asp-area="Admin"
                   asp-controller="Vocabulary"
                   asp-action="Create"
                   asp-route-lessonId="@ViewBag.LessonId">
                    + Thêm
                </a>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Từ vựng</th>
                        <th>Nghĩa</th>
                        <th>Phiên âm</th>
                        <th>Ví dụ</th>
                        <th>Bài học</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = (pageNumber - 1) * pageSize + 1;
                        foreach (var vocabulary in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td><span class="vocabulary-word">@vocabulary.Word</span></td>
                                <td>@vocabulary.Meaning</td>
                                <td>@vocabulary.Phoenic</td>
                                <td class="example-cell">@Html.Raw(vocabulary.Example)</td>
                                <td>@vocabulary.LessonTitle</td>
                                <td class="vocabulary-actions">
                                    <a class="btn-small"
                                       asp-area="Admin"
                                       asp-controller="Vocabulary"
                                       asp-action="Edit"
                                       asp-route-id="@vocabulary.VocabularyId">
                                        Sửa
                                    </a>
                                    <form asp-area="Admin"
                                          asp-controller="Vocabulary"
                                          asp-action="Delete"
                                          method="post"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@vocabulary.VocabularyId" />
                                        <input type="hidden" name="lessonId" value="@vocabulary.LessonId" />
                                        <button type="submit" class="btn-small danger" onclick="return confirm('Bạn có chắc muốn xóa từ vựng này không?');">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" style="text-align:center;">Không có dữ liệu.</td></tr>
                    }
                </tbody>
            </table>
        </div>


        @if (totalPages > 1)
        {
            <div class="pagination">
                @if (pageNumber > 1)
                {
                    <a asp-area="Admin"
                       asp-controller="Vocabulary"
                       asp-action="Index"
                       asp-route-pageNumber="@(pageNumber - 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-word="@ViewBag.Word"
                       asp-route-lessonId="@ViewBag.LessonId"
                       class="pagination-btn">
                        &lt;
                    </a>
                }
                else
                {
                    <span class="pagination-btn disabled">&lt;</span>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-area="Admin"
                       asp-controller="Vocabulary"
                       asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-pageSize="@pageSize"
                       asp-route-word="@ViewBag.Word"
                       asp-route-lessonId="@ViewBag.LessonId"
                       class="pagination-btn @(i == pageNumber ? "active" : "")">
                        @i
                    </a>
                }
                @if (pageNumber < totalPages)
                {
                    <a asp-area="Admin"
                       asp-controller="Vocabulary"
                       asp-action="Index"
                       asp-route-pageNumber="@(pageNumber + 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-word="@ViewBag.Word"
                       asp-route-lessonId="@ViewBag.LessonId"
                       class="pagination-btn">
                        &gt;
                    </a>
                }
                else
                {
                    <span class="pagination-btn disabled">&gt;</span>
                }
            </div>
        }
    </div>
</section>