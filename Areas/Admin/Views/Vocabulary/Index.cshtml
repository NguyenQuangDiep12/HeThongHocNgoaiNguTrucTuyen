@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.Vocabulary
@model List<VocabularyInfoResponse>

@{
    int lessonId = ViewBag.LessonId ?? 0;
    string lessonTitle = ViewBag.LessonTitle ?? string.Empty;
    int topicId = ViewBag.TopicId ?? 0;
    string topicName = ViewBag.TopicName ?? string.Empty;

    int pageNumber = ViewBag.PageNumber ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;

    var filter = ViewBag.Filter as VocabularyFilterRequest ?? new VocabularyFilterRequest();
    string word = filter.Word ?? ViewBag.Word ?? string.Empty;
}

@section Styles {
    <style>
        .muted {
            margin: 4px 0 0;
            color: #667085;
            font-size: 11px;
        }
        .vocabulary-actions {
            white-space: nowrap;
        }
        .vocabulary-word {
            font-weight: 600;
        }
        .example-cell {
            max-width: 250px;
            white-space: normal;
        }
    </style>
}
<section class="page-section">
    <div class="content-card">
        <div class="section-head">
            <div>
                <a asp-area="Admin" asp-controller="Lesson" asp-action="Index" asp-route-topicId="@topicId" class="btn-small">← Quay lại danh sách bài học (@lessonTitle)</a>
                <h2 style="margin-top: 8px;">Quản lý từ vựng - @lessonTitle</h2>
                <p class="muted">Bài học: @lessonTitle (Chủ đề: @topicName)</p>
            </div>
            @if (TempData["NotFound"] != null)
            {
                <div class="text-danger">
                    @TempData["NotFound"]
                </div>
            }
            <div class="toolbar">
                <form asp-area="Admin"
                      asp-controller="Vocabulary"
                      asp-action="Index"
                      method="get">
                    <div class="search-control">
                        <span>⌕</span>
                        <input type="hidden" name="lessonId" value="@lessonId" />
                        <input type="text" name="Word" value="@word" placeholder="Tìm kiếm từ vựng..." />
                        <input type="hidden" name="pageNumber" value="1"/>
                        <input type="hidden" name="pageSize" value="@pageSize" />
                        <button type="submit" class="btn-small">Tìm kiếm</button>
                    </div>
                </form>
                <a class="btn btn-dark"
                   asp-area="Admin"
                   asp-controller="Vocabulary"
                   asp-action="Create"
                   asp-route-lessonId="@lessonId">
                    + Thêm
                </a>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Từ vựng</th>
                        <th>Nghĩa</th>
                        <th>Phiên âm</th>
                        <th>Ví dụ</th>
                        <th>Bài học</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = (pageNumber - 1) * pageSize + 1;
                        foreach (var vocabulary in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td><span class="vocabulary-word">@vocabulary.Word</span></td>
                                <td>@vocabulary.Meaning</td>
                                <td>@vocabulary.Phoenic</td>
                                <td class="example-cell">@Html.Raw(vocabulary.Example)</td>
                                <td>@vocabulary.LessonTitle</td>
                                <td class="vocabulary-actions">
                                    <a class="btn-small"
                                       asp-area="Admin"
                                       asp-controller="Vocabulary"
                                       asp-action="Edit"
                                       asp-route-id="@vocabulary.VocabularyId"
                                       asp-route-lessonId="@lessonId">
                                        Sửa
                                    </a>
                                    <form asp-area="Admin"
                                          asp-controller="Vocabulary"
                                          asp-action="Delete"
                                          asp-route-id="@vocabulary.VocabularyId"
                                          asp-route-lessonId="@lessonId"
                                          method="post"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-small danger" onclick="return confirm('Bạn có chắc muốn xóa từ vựng này không?');">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" style="text-align:center;">Không có dữ liệu.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div class="pagination">
                @if (pageNumber > 1)
                {
                    <a asp-area="Admin"
                       asp-controller="Vocabulary"
                       asp-action="Index"
                       asp-route-lessonId="@lessonId"
                       asp-route-pageNumber="@(pageNumber - 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-Word="@word">
                        &lt;
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-area="Admin"
                       asp-controller="Vocabulary"
                       asp-action="Index"
                       asp-route-lessonId="@lessonId"
                       asp-route-pageNumber="@i"
                       asp-route-pageSize="@pageSize"
                       asp-route-Word="@word"
                       class="@(i == pageNumber ? "active" : "")">
                        @i
                    </a>
                }
                @if (pageNumber < totalPages)
                {
                    <a asp-area="Admin"
                       asp-controller="Vocabulary"
                       asp-action="Index"
                       asp-route-lessonId="@lessonId"
                       asp-route-pageNumber="@(pageNumber + 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-Word="@word">
                        &gt;
                    </a>
                }
            </div>
        }
    </div>
</section>


