@model HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.QuestionRequest

@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses

@{
    var tests =
        ViewBag.Tests as List<TestInfoResponse>
        ?? new List<TestInfoResponse>();
}

<section class="page-section">

    <div class="content-card">

        <div class="section-head">
            <h2>Thêm câu hỏi</h2>
        </div>

        <form asp-area="Admin"
              asp-controller="Question"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">

                <label asp-for="TestId">
                    Bài kiểm tra
                </label>

                <select asp-for="TestId"
                        id="TestId">

                    <option value="0">
                        -- Chọn bài kiểm tra --
                    </option>

                    @foreach (var test in tests)
                    {
                        <option value="@test.TestId"
                                data-mode="@test.TestMode"
                                data-part="@test.PartNumber">

                            @test.Title

                        </option>
                    }

                </select>

                <span asp-validation-for="TestId">
                </span>

            </div>

            <div class="form-group"
                 id="part-group">

                <label asp-for="PartNumber">
                    Part
                </label>

                <select asp-for="PartNumber"
                        id="PartNumber">

                    <option value="">
                        -- Chọn Part --
                    </option>

                    @for (int i = 1; i <= 7; i++)
                    {
                        <option value="@i">
                            Part @i
                        </option>
                    }

                </select>

                <span asp-validation-for="PartNumber">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Content">
                    Nội dung câu hỏi
                </label>

                <textarea class="ckeditor" asp-for="Content"
                          rows="5"
                          placeholder="Nhập nội dung câu hỏi...">
                </textarea>

                <span asp-validation-for="Content">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="QuestionOrder">
                    Thứ tự câu hỏi
                </label>

                <input asp-for="QuestionOrder"
                       type="number"
                       min="1" />

                <span asp-validation-for="QuestionOrder">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="AudioUrl">
                    Đường dẫn Audio
                </label>

                <input asp-for="AudioUrl"
                       placeholder="https://..." />

                <span asp-validation-for="AudioUrl">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="ImageUrl">
                    Đường dẫn hình ảnh
                </label>

                <input asp-for="ImageUrl"
                       placeholder="https://..." />

                <span asp-validation-for="ImageUrl">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="GroupCode">
                    Mã nhóm câu hỏi
                </label>

                <input asp-for="GroupCode"
                       placeholder="Ví dụ: PART3_GROUP_01" />

                <span asp-validation-for="GroupCode">
                </span>

            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn btn-dark">
                    Thêm câu hỏi
                </button>
                <a asp-area="Admin"
                   asp-controller="Question"
                   asp-action="Index"
                   class="btn btn-light">

                    Quay lại

                </a>
            </div>

        </form>

    </div>

</section>

@section Scripts
{
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script>
            document.querySelectorAll('.ckeditor').forEach(element => {

            ClassicEditor.create(element, {
                    toolbar: ["undo","redo","|","heading","|","bold","italic","|","fontSize","fontFamily","fontColor","fontBackgroundColor","|","bulletedList","numberedList"]
                })
                .catch(error => {
                    console.error(error);
                });

        });
    </script>
}