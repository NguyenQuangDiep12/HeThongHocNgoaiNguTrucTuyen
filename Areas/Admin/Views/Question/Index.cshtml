
@section Styles{
    <style>
        .content-grid.question-grid {
            display: grid;
            grid-template-columns: 1.15fr .85fr;
            gap: 16px;
        }

        .question-topbar {
            margin: -18px -18px 18px;
            background: #fff;
            border-bottom: 1px solid #e2e5ea;
            padding: 10px 18px;
        }

        .question-meta {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            font-size: 11px;
            color: #667085;
        }

        .question-editor h2 {
            margin: 0 0 14px;
            font-size: 14px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 80px;
            gap: 10px;
        }

        .form-group {
            margin-bottom: 11px;
        }

            .form-group label,
            .answers-head label {
                display: block;
                font-size: 11px;
                font-weight: 600;
                color: #4b5565;
                margin-bottom: 5px;
            }

        .form-control {
            width: 100%;
            height: 32px;
            border: 1px solid #d9dee7;
            border-radius: 5px;
            padding: 0 9px;
            outline: 0;
        }

        .textarea {
            height: 65px;
            padding: 7px;
            resize: vertical;
        }

        .answer-row {
            display: grid;
            grid-template-columns: 28px 1fr 22px;
            gap: 6px;
            align-items: center;
            margin: 7px 0;
        }

        .answer-letter {
            background: #f1f2f4;
            border-radius: 4px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .editor-footer {
            margin-top: 14px;
            padding-top: 12px;
            border-top: 1px solid #e5e7eb;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }
    </style>
}

<section class="page-section">

    <div class="question-topbar">

        <div class="question-meta">

            <strong>Bài kiểm tra đang chọn:</strong>

            <select class="select-control accent">
                <option>
                    Bài kiểm tra A1 - Chủ đề 1
                </option>
            </select>

            <span>
                Bài học:
                <strong>A1. Quản lý ngôn ngữ / chủ đề</strong>
            </span>

            <span>
                Số câu hỏi:
                <strong>20</strong>
            </span>

            <span>
                Điểm đạt:
                <strong>70%</strong>
            </span>

            <span>
                Thời gian:
                <strong>30 phút</strong>
            </span>

        </div>

    </div>

    <div class="content-grid question-grid">

        <div class="content-card">

            <div class="section-head">

                <div>
                    <span class="page-tag purple">
