@model List<HeThongHocNgoaiNguTrucTuyen.Dtos.Responses.TestInfoResponse>

@{
    int pageNumber = ViewBag.PageNumber ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<section class="page-section">

    <div class="content-card">

        <div class="section-head">

            <div>
                <h2>Danh sách bài kiểm tra</h2>
            </div>

            <a class="btn btn-purple"
               asp-area="Admin"
               asp-controller="Test"
               asp-action="Create">

                + Thêm bài kiểm tra

            </a>

        </div>

        <div class="toolbar">

            <form asp-area="Admin"
                  asp-controller="Test"
                  asp-action="Index"
                  method="get">

                <div class="search-control">

                    <span>⌕</span>

                    <input type="text"
                           name="Title"
                           value="@Context.Request.Query["Title"]"
                           placeholder="Tìm kiếm tên bài kiểm tra..." />

                </div>

                <select name="PartNumber">

                    <option value="">
                        Tất cả Part
                    </option>

                    @for (int i = 1; i <= 7; i++)
                    {
                        <option value="@i">
                            Part @i
                        </option>
                    }

                </select>

                <input type="hidden"
                       name="pageSize"
                       value="@pageSize" />

                <button type="submit"
                        class="btn btn-dark">

                    Tìm kiếm

                </button>

            </form>

        </div>

        <div class="table-wrap">

            <table class="data-table">

                <thead>

                    <tr>

                        <th>STT</th>

                        <th>Tên bài kiểm tra</th>

                        <th>Loại</th>

                        <th>Part</th>

                        <th>Số câu hỏi</th>

                        <th>Thời gian</th>

                        <th>Thao tác</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var index =
                        (pageNumber - 1) * pageSize + 1;

                        foreach (var test in Model)
                        {
                            <tr>

                                <td>
                                    @index
                                </td>

                                <td>
                                    <strong>
                                        @test.Title
                                    </strong>
                                </td>

                                <td>
                                    @test.TestModeDisplay
                                </td>

                                <td>

                                    @if (test.TestMode == 0)
                                    {
                                        <span>
                                            Part @test.PartNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Part 1 - 7
                                        </span>
                                    }

                                </td>

                                <td>
                                    @test.QuestionCount
                                </td>

                                <td>
                                    @test.DurationMinutes phút
                                </td>

                                <td class="action-cell">

                                    <a class="btn-small"
                                       asp-area="Admin"
                                       asp-controller="Test"
                                       asp-action="Edit"
                                       asp-route-id="@test.TestId">

                                        Sửa

                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="Test"
                                          asp-action="Delete"
                                          asp-route-id="@test.TestId"
                                          method="post"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-small danger"
                                                onclick="return confirm('Bạn có chắc muốn xóa bài kiểm tra này không?');">

                                            Xóa

                                        </button>

                                    </form>

                                </td>

                            </tr>

                            index++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7">
                                Không có bài kiểm tra nào.
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (totalPages > 1)
        {
            <div class="pagination">

                @if (pageNumber > 1)
                {
                    <a asp-action="Index"
                       asp-route-Title="@Context.Request.Query["Title"]"
                       asp-route-PartNumber="@Context.Request.Query["PartNumber"]"
                       asp-route-pageSize="@pageSize"
                       asp-route-pageNumber="@(pageNumber - 1)"
                       class="pagination-btn">

                        &lt;

                    </a>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-Title="@Context.Request.Query["Title"]"
                       asp-route-PartNumber="@Context.Request.Query["PartNumber"]"
                       asp-route-pageSize="@pageSize"
                       asp-route-pageNumber="@i"
                       class="pagination-btn @(i == pageNumber ? "disabled" : "")">

                        @i

                    </a>
                }

                @if (pageNumber < totalPages)
                {
                    <a asp-action="Index"
                       asp-route-Title="@Context.Request.Query["Title"]"
                       asp-route-PartNumber="@Context.Request.Query["PartNumber"]"
                       asp-route-pageSize="@pageSize"
                       asp-route-pageNumber="@(pageNumber + 1)"
                       class="pagination-btn">

                        &gt;

                    </a>
                }

            </div>
        }

    </div>

</section>