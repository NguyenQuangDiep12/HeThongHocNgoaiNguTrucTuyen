@using System.Text.RegularExpressions;
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses;

@model List<TestInfoResponse>

@functions {
    public string GetPreview(string? content, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return "";
        }
        var text = Regex.Replace(content, "<.*?>", string.Empty);
        text = Regex.Replace(text, @"\s+", " ").Trim();
        if (text.Length > maxLength)
        {
            return text.Substring(0, maxLength) + "...";
        }
        return text;
    }
}

@{
    var pageSize = ViewBag.PageSize ?? 10;
    var pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages;
    string title = ViewBag.Title;
}

<section class="page-section">
    <div class="content-card">
        <div class="section-head">
            <h1>Quản lý bài kiểm tra</h1>
            <div><a 
                    asp-area="Admin" 
                    asp-controller="Test" 
                    asp-action="Create" class="btn btn-dark">
                    + Thêm bài kiểm tra
                </a>
            </div>
        </div>
        <div>
            <div>
                <p>Danh sách bài kiểm tra hiện tại</p>
            </div>

            @if(TempData["Error"] != null)
            {
                <div class="text-danger notification">@TempData["Error"]</div>
            }else if(TempData["NotFound"] != null)
            {
                <div class="text-danger notification">@TempData["NotFound"]</div>
            }
            @if(TempData["Success"] != null)
            {
                <div class="notification" style="color: green;">@TempData["Success"]</div>
            }
            <div class="toolbar" style="justify-content: right;">
                    <form asp-area="Admin"
                          asp-controller="Test"
                          asp-action="Index"
                          method="get">
                        <div class="search-control">
                            <span><i class="fa fa-search" aria-hidden="true"></i></span>
                            <input type="search" name="Title" placeholder="Tìm kiếm bài kiểm tra..."/>
                            <button class="btn-small" type="submit">Tìm kiếm</button>
                        </div>
                    </form>
                </div>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Tên bài kiểm tra</th>
                        <th>Mô tả</th>
                        <th>Số câu hỏi</th>
                        <th>Thời gian (phút)</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = ((pageNumber - 1) * pageSize) + 1;
                        foreach (var test in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@Html.Raw(GetPreview(test.Title, 20))</td>
                                <td>@Html.Raw(GetPreview(test.Description, 20))</td>
                                <td>@test.QuestionCount</td>
                                <td>@test.DurationMinutes</td>
                                <td style="display: flex; align-items: center; gap: 4px;">
                                <a class="btn-small"
                                    asp-area="Admin"
                                    asp-controller="Test"
                                    asp-action="Edit"
                                    asp-route-id="@test.TestId">
                                    <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                </a>

                                <form asp-area="Admin"
                                        asp-controller="Test"
                                        asp-action="Delete"
                                        asp-route-id="@test.TestId"
                                        method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn-small danger" onclick="return confirm('Xác nhận xóa bài thi')" type="submit">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </button>
                                </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="6">Không có dữ liệu bài kiểm tra</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Phân trang -->
        <div class="pagination">
            @if(pageNumber > 1)
            {
                <a 
                    asp-area="Admin"
                    asp-controller="Test"
                    asp-action="Index"
                    asp-route-pageNumber="@(pageNumber - 1)"
                    asp-route-pageSize="@pageSize"
                    asp-route-Title="@title"
                    class="pagination-btn">
                    &lt;
                </a>
            }
            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-area="Admin"
                   asp-controller="Test"
                   asp-action="Index"
                   asp-route-pageNumber="@i"
                   asp-route-pageSize="@pageSize"
                   asp-route-Title="@title"
                   class="pagination-btn">
                    @(i)
                </a>
            }
            @if(pageNumber < totalPages)
            {
                <a asp-area="Admin"
                   asp-controller="Test"
                   asp-action="Index"
                   asp-route-pageNumber="@(pageNumber + 1)"
                   asp-route-pageSize="@pageSize"
                   asp-route-Title="@title"
                   class="pagination-btn">
                    &gt;
                </a>
            }
        </div>
    </div>
</section>