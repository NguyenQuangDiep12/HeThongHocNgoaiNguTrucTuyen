@using HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.Test
@using HeThongHocNgoaiNguTrucTuyen.Models.Enums

@model TestRequest

<section class="page-section">

    <div class="content-card">

        <div class="section-head">

            <h2>Tạo bài kiểm tra</h2>
        </div>

        <form asp-area="Admin"
              asp-controller="Test"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">

                <label asp-for="Title">
                    Tên bài kiểm tra
                </label>

                <input asp-for="Title"
                       placeholder="Ví dụ: TOEIC Full Test 01" />

                <span asp-validation-for="Title"></span>

            </div>

            <div class="form-group">

                <label asp-for="TestMode">
                    Loại bài kiểm tra
                </label>

                <select asp-for="TestMode"
                        id="TestMode">

                    <option value="@TestMode.PART">
                        Part Test
                    </option>

                    <option value="@TestMode.FULL">
                        Full Test
                    </option>

                </select>

            </div>

            <div class="form-group"
                 id="part-container">

                <label asp-for="PartNumber">
                    Chọn Part
                </label>

                <select asp-for="PartNumber">

                    <option value="">
                        -- Chọn Part --
                    </option>

                    @for (int i = 1; i <= 7; i++)
                    {
                        <option value="@i">
                            Part @i
                        </option>
                    }

                </select>

                <span asp-validation-for="PartNumber"></span>

            </div>

            <div class="form-group">

                <label asp-for="DurationMinutes">
                    Thời gian làm bài (phút)
                </label>

                <input asp-for="DurationMinutes"
                       type="number"
                       min="1"
                       placeholder="Ví dụ: 30" />

                <span asp-validation-for="DurationMinutes"></span>

            </div>

            <div class="form-group">

                <label asp-for="Description">
                    Mô tả
                </label>

                <textarea asp-for="Description" class="ckeditor" rows="5" placeholder="Nhập mô tả bài kiểm tra..."></textarea>

                <span asp-validation-for="Description"></span>

            </div>

            <div class="form-actions">

                <a asp-area="Admin"
                   asp-controller="Test"
                   asp-action="Index"
                   class="btn">

                    Quay lại

                </a>

                <button type="submit" class="btn btn-dark">

                    Tạo bài kiểm tra

                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts
{
    <script src="~/lib/ckeditor5/ckeditor.js"></script>
    <script>
            document.querySelectorAll('.ckeditor').forEach(element => {

            ClassicEditor.create(element, {
                    toolbar: ["undo","redo","|","heading","|","bold","italic","|","fontSize","fontFamily","fontColor","fontBackgroundColor","|","bulletedList","numberedList"]
                })
                .catch(error => {
                    console.error(error);
                });
        });
    </script>
    <script>
        const testMode = document.getElementById("TestMode");
        const partContainer = document.getElementById("part-container");
        const partSelect = document.querySelector('[name="PartNumber"]');
        function updatePartVisibility() {
            // FULL = 1
            if (testMode.value === "1") {
                partContainer.style.display = "none";
                partSelect.value = "";
            }
            else {
                partContainer.style.display = "block";
            }
        }
        testMode.addEventListener("change", updatePartVisibility);
        updatePartVisibility();
    </script>
}


