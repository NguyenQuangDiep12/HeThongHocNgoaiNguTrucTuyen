<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị nội dung học</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" asp-append-version="true"/>
    @RenderSection("Styles", required: false)
</head>

<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-profile">
                <div class="admin-avatar">
                    <span><i class="fa fa-user-circle-o" aria-hidden="true"></i></span>
                </div>
                <div class="admin-name">
                    Admin
                </div>
            </div>
            <nav class="admin-nav">

                <a class="admin-nav-item"
                   asp-area="Admin"
                   asp-controller="Language"
                   asp-action="Index">
                    Quản lý ngôn ngữ
                </a>
                <a class="admin-nav-item"
                   asp-area="Admin"
                   asp-controller="Topic"
                   asp-action="Index">
                    Quản lý chủ đề
                </a>
                <a class="admin-nav-item"
                   asp-area="Admin"
                   asp-controller="Lesson"
                   asp-action="Index">
                    Quản lý bài học
                </a>
                <a class="admin-nav-item"
                   asp-area="Admin"
                   asp-controller="Vocabulary"
                   asp-action="Index">
                    Quản lý từ vựng
                </a>

                <a class="admin-nav-item"
                   asp-area="Admin"
                   asp-controller="Test"
                   asp-action="Index">
                    Quản lý bài kiểm tra
                </a>
            </nav>
        </aside>
        <div class="admin-main">
            <div class="admin-header">
                <div class="admin-header-title">
                    <span class="menu-icon">
                        <i class="fa fa-bars" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="admin-user">
                    <div id="userMenuButton">
                        <i class="fa fa-user"></i>
                        <span>Admin</span>
                    </div>
                    <div class="user-info" id="userDropdown">
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            <i class="fa fa-home"></i>
                            Về trang chủ
                        </a>
                        <form class="form-logout"
                              asp-area=""
                              asp-controller="Auth"
                              asp-action="Logout"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit">
                                <i class="fa fa-sign-out"></i>
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <main id="admin-main-content" class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>