@model HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.TopicRequest
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses

@{
    var languages =
 ViewBag.Languages as List<LanguageInfoResponse> ?? new List<LanguageInfoResponse>();
}

<section class="page-section">

    <div class="content-card">

        <div class="section-head">
            <h2>Thêm chủ đề</h2>
        </div>
        <form asp-area="Admin"
              asp-controller="Topic"
              asp-action="Create"
              method="post"
              class="topic-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>
            <div class="topic-form-group">
                <label asp-for="Name">
                    Tên chủ đề
                </label>
                <input asp-for="Name"
                       placeholder="Nhập tên chủ đề..." />
                <span asp-validation-for="Name">
                </span>
            </div>
            <div class="topic-form-group">
                <label asp-for="LanguageId">
                    Ngôn ngữ
                </label>
                <select asp-for="LanguageId">
                    <option value="0">
                        -- Chọn ngôn ngữ --
                    </option>
                    @foreach (var language in languages)
                    {
                        <option value="@language.LanguageId">
                            @language.Name
                        </option>
                    }
                </select>
                <span asp-validation-for="LanguageId">
                </span>
            </div>
            <div class="topic-form-group">
                <label asp-for="Level">
                    Cấp độ
                </label>
                <input asp-for="Level" placeholder="Ví dụ: A1, A2, B1..." />
                <span asp-validation-for="Level">
                </span>
            </div>
            <div class="topic-form-group">
                <label asp-for="Description">
                    Mô tả
                </label>
                <textarea class="ckeditor" asp-for="Description" placeholder="Nhập mô tả chủ đề...">
                </textarea>
                <span asp-validation-for="Description"> </span>
            </div>
            <div class="topic-form-group">
                <label asp-for="ImageUrl">
                    Đường dẫn hình ảnh
                </label>
                <input asp-for="ImageUrl" placeholder="https://..." />
                <span asp-validation-for="ImageUrl"></span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-dark">
                    Thêm mới
                </button>
                <a asp-area="Admin"
                   asp-controller="Topic"
                   asp-action="Index"
                   class="btn">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</section>
@section Scripts {
    <script src="~/lib/ckeditor5/ckeditor.js"></script>
    <script>
            document.querySelectorAll('.ckeditor').forEach(element => {

            ClassicEditor.create(element, {
            toolbar: ["undo","redo","|","heading","|","bold","italic","|","fontSize","fontFamily","fontColor","fontBackgroundColor","|","bulletedList","numberedList"]
            })
            .catch(error => {
                console.error(error);
            });
        });
    </script>
}