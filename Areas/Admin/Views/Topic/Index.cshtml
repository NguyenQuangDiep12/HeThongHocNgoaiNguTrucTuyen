

@section Styles{
    <style>
        /* Topic page */

        .topic-actions {
            white-space: nowrap;
        }
    </style>
}

<section class="page-section">

    <div class="content-card">

        <div class="section-head">

            <h2>Danh sách chủ đề</h2>

            <div class="toolbar">

                <div class="search-control">
                    <span>⌕</span>
                    <input type="text"
                           placeholder="Tìm kiếm chủ đề..." />
                </div>

                <select class="select-control">
                    <option>Ngôn ngữ: Tất cả</option>
                    <option>Tiếng Anh</option>
                    <option>Tiếng Nhật</option>
                </select>

                <select class="select-control">
                    <option>Cấp độ: Tất cả</option>
                    <option>A1</option>
                    <option>A2</option>
                    <option>B1</option>
                </select>

                <a class="btn btn-dark"
                   asp-area="Admin"
                   asp-controller="Topic"
                   asp-action="Create">
                    + Thêm mới
                </a>

            </div>
        </div>

        <table class="data-table">

            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên chủ đề</th>
                    <th>Ngôn ngữ</th>
                    <th>Cấp độ</th>
                    <th>Hành động</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>1</td>
                    <td>Chào hỏi</td>
                    <td>Tiếng Anh</td>
                    <td>A1</td>
                    <td>
                        <a class="btn-small" href="#">Sửa</a>
                        <button class="btn-small danger">Xóa</button>
                    </td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Gia đình</td>
                    <td>Tiếng Nhật</td>
                    <td>N5</td>
                    <td>
                        <a class="btn-small" href="#">Sửa</a>
                        <button class="btn-small danger">Xóa</button>
                    </td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>Du lịch</td>
                    <td>Tiếng Hàn</td>
                    <td>Sơ cấp</td>
                    <td>
                        <a class="btn-small" href="#">Sửa</a>
                        <button class="btn-small danger">Xóa</button>
                    </td>
                </tr>

            </tbody>
        </table>

        <partial name="~/Areas/Admin/Views/Shared/_Pagination.cshtml" />

    </div>
</section>