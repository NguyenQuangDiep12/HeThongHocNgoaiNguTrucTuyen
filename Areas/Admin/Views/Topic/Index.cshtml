@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.Topic

@model List<TopicInfoResponse>

@{
    int languageId = ViewBag.LanguageId ?? 0;
    string languageName = ViewBag.LanguageName ?? string.Empty;
    int pageNumber = ViewBag.PageNumber ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;

    var levels = ViewBag.Levels as List<string> ?? new List<string>();
    var filter = ViewBag.Filter as TopicFilterRequest ?? new TopicFilterRequest();
}

<section class="page-section">
    <div class="content-card">
        <div class="section-head">
            <div>
                <a asp-area="Admin" asp-controller="Language" asp-action="Index" class="btn-small">← Quay lại danh sách ngôn ngữ</a>
                <h2 style="margin-top: 8px;">Danh sách chủ đề - @languageName</h2>
            </div>
            @if (TempData["NotFound"] != null)
            {
                <div class="text-danger">
                    @TempData["NotFound"]
                </div>
            }
            <div class="text-danger" asp-validation-summary="ModelOnly"></div>
            <div class="toolbar">
                <form asp-area="Admin"
                      asp-controller="Topic"
                      asp-action="Index"
                      method="get"
                      class="topic-filter-form">
                    <input type="hidden" name="languageId" value="@languageId" />
                    <input type="text" name="Name" value="@filter.Name" placeholder="Tìm kiếm tên chủ đề..." class="input-control" />
                    <select class="select-control" name="Level">
                        <option value="">-- Cấp độ: Tất cả --</option>
                        @foreach (var level in levels)
                        {
                            <option value="@level" selected="@(filter.Level == level)">@level</option>
                        }
                    </select>
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <input type="hidden" name="pageNumber" value="1" />
                    <button type="submit" class="btn">Lọc</button>
                </form>
                <a asp-area="Admin"
                   asp-controller="Topic"
                   asp-action="Create"
                   asp-route-languageId="@languageId"
                   class="btn btn-dark">
                    + Thêm mới
                </a>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Tên chủ đề</th>
                        <th>Ngôn ngữ</th>
                        <th>Cấp độ</th>
                        <th>Mô tả</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = (pageNumber - 1) * pageSize + 1;
                        foreach (var topic in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@topic.Name</td>
                                <td>@topic.LanguageName</td>
                                <td>@topic.Level</td>
                                <td>@Html.Raw(topic.Description)</td>
                                <td class="action-cell">
                                    <a asp-area="Admin"
                                       asp-controller="Lesson"
                                       asp-action="Index"
                                       asp-route-topicId="@topic.TopicId"
                                       class="btn-small">
                                        Xem bài học
                                    </a>
                                    <a asp-area="Admin"
                                       asp-controller="Topic"
                                       asp-action="Edit"
                                       asp-route-id="@topic.TopicId"
                                       asp-route-languageId="@languageId"
                                       class="btn-small">
                                        Sửa
                                    </a>
                                    <form asp-area="Admin"
                                          asp-controller="Topic"
                                          asp-action="Delete"
                                          asp-route-id="@topic.TopicId"
                                          asp-route-languageId="@languageId"
                                          method="post"
                                          style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn-small danger"
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa chủ đề này?');">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">Không có dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div class="pagination">
                @if (pageNumber > 1)
                {
                    <a asp-area="Admin"
                       asp-controller="Topic"
                       asp-action="Index"
                       asp-route-languageId="@languageId"
                       asp-route-pageSize="@pageSize"
                       asp-route-pageNumber="@(pageNumber - 1)"
                       asp-route-Name="@filter.Name"
                       asp-route-Level="@filter.Level">
                        &lt;
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-area="Admin"
                       asp-controller="Topic"
                       asp-action="Index"
                       asp-route-languageId="@languageId"
                       asp-route-pageSize="@pageSize"
                       asp-route-pageNumber="@i"
                       asp-route-Name="@filter.Name"
                       asp-route-Level="@filter.Level"
                       class="@(i == pageNumber ? "active" : "")">
                        @i
                    </a>
                }
                @if (pageNumber < totalPages)
                {
                    <a asp-area="Admin"
                       asp-controller="Topic"
                       asp-action="Index"
                       asp-route-languageId="@languageId"
                       asp-route-pageSize="@pageSize"
                       asp-route-pageNumber="@(pageNumber + 1)"
                       asp-route-Name="@filter.Name"
                       asp-route-Level="@filter.Level">
                        &gt;
                    </a>
                }
            </div>
        }
    </div>
</section>