@using System.Text.RegularExpressions
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Requests
@model List<LessonInfoResponse>

@functions {
    public string GetPreview(string? content, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return "";
        }
        var text = Regex.Replace(content, "<.*?>", string.Empty);
        text = Regex.Replace(text, @"\s+", " ").Trim();
        if (text.Length > maxLength)
        {
            return text.Substring(0, maxLength) + "...";
        }
        return text;
    }
}
@{
    int topicId = ViewBag.TopicId ?? 0;
    string topicName = ViewBag.TopicName ?? string.Empty;
    int languageId = ViewBag.LanguageId ?? 0;
    string languageName = ViewBag.LanguageName ?? string.Empty;

    int pageNumber = ViewBag.PageNumber ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;

    var filter = ViewBag.Filter as LessonFilterRequest ?? new LessonFilterRequest();
    string? title = filter.Title ?? ViewBag.Title;
}
@section Styles {
    <style>
        .data-table.compact {
            font-size: 12px;
        }
        .select-control.small {
            min-width: 150px;
        }
        .lesson-title {
            font-weight: 600;
            color: #344054;
        }
        .lesson-description {
            max-width: 180px;
            color: #667085;
            line-height: 1.5;
        }
        .lesson-content-preview {
            max-width: 300px;
            color: #475467;
            line-height: 1.5;
        }
        .lesson-content-empty {
            color: #98a2b3;
            font-style: italic;
        }
        .action-cell {
            white-space: nowrap;
        }
    </style>
}
<section class="page-section">
<div class="content-card">
    <div class="section-head">
        <h2>Danh sách bài học</h2>
            @if(TempData["Error"] != null)
            {
                <span class="text-danger notification">@TempData["Error"]</span>
            }
            <div class="toolbar">
            <form asp-area="Admin"
                    asp-controller="Lesson"
                    asp-action="Index"
                    method="get">
                <div class="search-control">
                    <span><i class="fa fa-search" aria-hidden="true"></i></span>
                    <input type="text" name="title" value="@ViewBag.Title" placeholder="Tìm kiếm bài học..." />
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <input type="hidden" name="pageNumber" value="1" />
                    <button type="submit" class="btn-small"> Tìm kiếm </button>
                </div>
            </form>
            <a class="btn btn-dark"
                asp-area="Admin"
                asp-controller="Lesson"
                asp-action="Create">
                + Thêm bài học
            </a>
        </div>
    </div>
    <div class="table-wrap">
        <table class="data-table compact">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tiêu đề bài học</th>
                    <th>Ngôn ngữ</th>
                    <th>Chủ đề</th>
                    <th>Mô tả</th>
                    <th>Nội dung</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                var index = (pageNumber - 1) * pageSize + 1;
                foreach (var lesson in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td><div class="lesson-title">@lesson.Title</div></td>
                        <td>@lesson.LanguageName</td>
                        <td>@lesson.TopicName</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(lesson.Description))
                            {
                                <div class="lesson-description">@Html.Raw(GetPreview(lesson.Description, 20))</div>
                            }else{
                                <span class="lesson-content-empty">Chưa có mô tả</span>
                            }
                        </td>
                        <td>

                            @if (!string.IsNullOrWhiteSpace(lesson.Content))
                            {
                                <div class="lesson-content-preview">@Html.Raw(GetPreview(lesson.Content,20))</div>
                            }
                            else
                            {
                                <span class="lesson-content-empty">Chưa có nội dung</span>
                            }
                        </td>
                        <td class="action-cell">
                            <a class="btn-small"
                                asp-area="Admin"
                                asp-controller="Lesson"
                                asp-action="Detail"
                                asp-route-id="@lesson.LessonId">
                                <i class="fa fa-eye" aria-hidden="true"></i>
                            </a>
                            <a class="btn-small"
                                asp-area="Admin"
                                asp-controller="Lesson"
                                asp-action="Edit"
                                asp-route-id="@lesson.LessonId">
                                <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                            </a>
                            <form asp-area="Admin"
                                    asp-controller="Lesson"
                                    asp-action="Delete"
                                    asp-route-id="@lesson.LessonId"
                                    method="post"
                                    style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-small danger" onclick="return confirm('Bạn có chắc muốn xóa bài học này không?')">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr><td colspan="7">Không có dữ liệu bài học.</td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <div class="pagination">
            @if (pageNumber > 1)
            {
                <a asp-area="Admin"
                    asp-controller="Lesson"
                    asp-action="Index"
                    asp-route-pageNumber="@(pageNumber - 1)"
                    asp-route-pageSize="@pageSize"
                    asp-route-title="@ViewBag.Title"
                    asp-route-topicId="@ViewBag.TopicId"
                    class="pagination-btn">
                    &lt;
                </a>
            }
            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-area="Admin"
                    asp-controller="Lesson"
                    asp-action="Index"
                    asp-route-pageNumber="@i"
                    asp-route-pageSize="@pageSize"
                    asp-route-title="@ViewBag.Title"
                    asp-route-topicId="@ViewBag.TopicId"
                    class="pagination-btn">
                    @i
                </a>
            }
            @if (pageNumber < totalPages)
            {
                <a asp-area="Admin"
                    asp-controller="Lesson"
                    asp-action="Index"
                    asp-route-pageNumber="@(pageNumber + 1)"
                    asp-route-pageSize="@pageSize"
                    asp-route-title="@ViewBag.Title"
                    asp-route-topicId="@ViewBag.TopicId"
                    class="pagination-btn">
                    &gt;
                </a>
            }
        </div>
    }
    </div>
</section>


