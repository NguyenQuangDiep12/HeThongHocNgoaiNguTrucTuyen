@using System.Text.RegularExpressions
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.Lesson
@model List<LessonInfoResponse>

@functions {
    public string GetPreview(string? content, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return "";
        }
        var text = Regex.Replace(content, "<.*?>", string.Empty);
        text = Regex.Replace(text, @"\s+", " ").Trim();
        if (text.Length > maxLength)
        {
            return text.Substring(0, maxLength) + "...";
        }
        return text;
    }
}
@{
    int topicId = ViewBag.TopicId ?? 0;
    string topicName = ViewBag.TopicName ?? string.Empty;
    int languageId = ViewBag.LanguageId ?? 0;
    string languageName = ViewBag.LanguageName ?? string.Empty;

    int pageNumber = ViewBag.PageNumber ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;

    var filter = ViewBag.Filter as LessonFilterRequest ?? new LessonFilterRequest();
    string? title = filter.Title ?? ViewBag.Title;
}
@section Styles {
    <style>
        .data-table.compact {
            font-size: 12px;
        }
        .select-control.small {
            min-width: 150px;
        }
        .lesson-title {
            font-weight: 600;
            color: #344054;
        }
        .lesson-description {
            max-width: 180px;
            color: #667085;
            line-height: 1.5;
        }
        .lesson-content-preview {
            max-width: 300px;
            color: #475467;
            line-height: 1.5;
        }
        .lesson-content-empty {
            color: #98a2b3;
            font-style: italic;
        }
        .action-cell {
            white-space: nowrap;
        }
    </style>
}
<section class="page-section">
    <div class="content-card">
        <div class="section-head">
            <div>
                <a asp-area="Admin" asp-controller="Topic" asp-action="Index" asp-route-languageId="@languageId" class="btn-small">← Quay lại danh sách chủ đề (@topicName)</a>
                <h2 style="margin-top: 8px;">Danh sách bài học - @topicName</h2>
            </div>
            @if(TempData["NotFound"] != null)
            {
                <span class="text-danger">@TempData["NotFound"]</span>
            }
            <div class="toolbar">
                <form asp-area="Admin"
                      asp-controller="Lesson"
                      asp-action="Index"
                      method="get">
                    <div class="search-control">
                        <span>⌕</span>
                        <input type="hidden" name="topicId" value="@topicId" />
                        <input type="text" name="Title" value="@title" placeholder="Tìm kiếm bài học..." />
                        <input type="hidden" name="pageSize" value="@pageSize" />
                        <input type="hidden" name="pageNumber" value="1" />
                        <button type="submit" class="btn-small">Tìm kiếm</button>
                    </div>
                </form>
                <a class="btn btn-dark"
                   asp-area="Admin"
                   asp-controller="Lesson"
                   asp-action="Create"
                   asp-route-topicId="@topicId">
                    + Thêm bài học
                </a>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data-table compact">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Tiêu đề bài học</th>
                        <th>Ngôn ngữ</th>
                        <th>Chủ đề</th>
                        <th>Mô tả</th>
                        <th>Nội dung</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = (pageNumber - 1) * pageSize + 1;
                        foreach (var lesson in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td><div class="lesson-title">@lesson.Title</div></td>
                                <td>@lesson.LanguageName</td>
                                <td>@lesson.TopicName</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(lesson.Description))
                                    {
                                        <div class="lesson-description">@Html.Raw(GetPreview(lesson.Description, 60))</div>
                                    }
                                    else
                                    {
                                        <span class="lesson-content-empty">Chưa có mô tả</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(lesson.Content))
                                    {
                                        <div class="lesson-content-preview">@Html.Raw(GetPreview(lesson.Content, 100))</div>
                                    }
                                    else
                                    {
                                        <span class="lesson-content-empty">Chưa có nội dung</span>
                                    }
                                </td>
                                <td class="action-cell">
                                    <a class="btn-small"
                                       asp-area="Admin"
                                       asp-controller="Lesson"
                                       asp-action="Details"
                                       asp-route-id="@lesson.LessonId"
                                       asp-route-topicId="@topicId">
                                        Xem
                                    </a>
                                    <a class="btn-small"
                                       asp-area="Admin"
                                       asp-controller="Lesson"
                                       asp-action="Edit"
                                       asp-route-id="@lesson.LessonId"
                                       asp-route-topicId="@topicId">
                                        Sửa
                                    </a>
                                    <a class="btn-small"
                                       asp-area="Admin"
                                       asp-controller="Vocabulary"
                                       asp-action="Index"
                                       asp-route-lessonId="@lesson.LessonId">
                                        Xem từ vựng
                                    </a>
                                    <form asp-area="Admin"
                                          asp-controller="Lesson"
                                          asp-action="Delete"
                                          asp-route-id="@lesson.LessonId"
                                          asp-route-topicId="@topicId"
                                          method="post"
                                          style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-small danger" onclick="return confirm('Bạn có chắc muốn xóa bài học này không?')"> Xóa </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="7">Không có dữ liệu bài học.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div class="pagination">
                @if (pageNumber > 1)
                {
                    <a asp-area="Admin"
                       asp-controller="Lesson"
                       asp-action="Index"
                       asp-route-topicId="@topicId"
                       asp-route-pageNumber="@(pageNumber - 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-Title="@title"
                       class="pagination-btn">
                        &lt;
                    </a>
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == pageNumber)
                    {
                        <span class="active">@i</span>
                    }
                    else
                    {
                        <a asp-area="Admin"
                           asp-controller="Lesson"
                           asp-action="Index"
                           asp-route-topicId="@topicId"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@pageSize"
                           asp-route-Title="@title">
                            @i
                        </a>
                    }
                }
                @if (pageNumber < totalPages)
                {
                    <a asp-area="Admin"
                       asp-controller="Lesson"
                       asp-action="Index"
                       asp-route-topicId="@topicId"
                       asp-route-pageNumber="@(pageNumber + 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-Title="@title">
                        &gt;
                    </a>
                }
            </div>
        }
    </div>
</section>


