@model HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.UpdateLessonRequest
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses

@{
    var lessonId = ViewBag.LessonId;
    var topics = ViewBag.Topics as List<TopicInfoResponse>;
}

<section class="page-section">
    <div class="content-card">
        <div class="section-head"><h2>Chỉnh sửa bài học</h2></div>
        <form asp-area="Admin"
              asp-controller="Lesson"
              asp-action="Edit"
              asp-route-id="@lessonId"
              method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title"> Tiêu đề bài học </label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="topicDescription" asp-for="Description">Mô tả</label>
                <textarea id="topicDescription" asp-for="Description" class="form-control ckeditor" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="topicContent" asp-for="Content">Nội dung bài học</label>
                <textarea id="topicContent" asp-for="Content" class="form-control ckeditor"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-dark">Cập nhật</button>
            <a asp-area="Admin"
               asp-controller="Lesson"
               asp-action="Index"
               class="btn">
                Quay lại
            </a>
        </form>
    </div>
</section>
@section Scripts {
    <script src="~/lib/ckeditor5/ckeditor.js"></script>
    <script>
        document.querySelectorAll('.ckeditor').forEach(element => {
            ClassicEditor.create(element, {
                    toolbar: ["undo","redo","|","heading","|","bold","italic","|","fontSize","fontFamily","fontColor","fontBackgroundColor","|","bulletedList","numberedList"]
            })
            .catch(error => {
                console.error(error);
            });
        });
    </script>
}



