@model HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.LessonRequest
@{
    var topics =
        ViewBag.Topics as List<HeThongHocNgoaiNguTrucTuyen.Dtos.Responses.TopicInfoResponse>;
}
<section class="page-section">
    <div class="content-card">
        <div class="section-head"><h2>Thêm bài học</h2></div>
        <form asp-area="Admin"
              asp-controller="Lesson"
              asp-action="Create"
              method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="TopicId">Chủ đề</label>
                <select asp-for="TopicId" class="form-control">
                    <option value=""> -- Chọn chủ đề -- </option>
                    @if (topics != null)
                    {
                        foreach (var topic in topics)
                        {
                            <option value="@topic.TopicId">
                                @topic.Name
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="TopicId"class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title">Tiêu đề bài học</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Mô tả</label>
                <textarea asp-for="Description" id="description-editor" class="form-control ckeditor"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Content">Nội dung bài học</label>
                <textarea asp-for="Content" id="content-editor" class="form-control ckeditor"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-dark">Lưu</button>
            <a asp-area="Admin"
               asp-controller="Lesson"
               asp-action="Index"
               class="btn">
                Quay lại
            </a>
        </form>
    </div>
</section>
@section Scripts {
    <script src="~/lib/ckeditor5/ckeditor.js"></script>
    <script>
        document.querySelectorAll('.ckeditor').forEach(element => {

        ClassicEditor.create(element, {
        toolbar: ["undo","redo","|","heading","|","bold","italic","|","fontSize","fontFamily","fontColor","fontBackgroundColor","|","bulletedList","numberedList"]
        })
        .catch(error => {
            console.error(error);
        });
    });
    </script>
}