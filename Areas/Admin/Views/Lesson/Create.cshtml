@using HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.Lesson
@using HeThongHocNgoaiNguTrucTuyen.Dtos.Responses
@model CreateLessonRequest
@{
    var topics = ViewBag.Topics as List<TopicInfoResponse>;
}
<section class="page-section">
    <div class="content-card">
        <div class="section-head"><h2>Thêm bài học</h2></div>
        <form asp-area="Admin"
              asp-controller="Lesson"
              asp-action="Create"
              asp-route-topicId="@Model.TopicId"
              method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TopicId" />

            <div class="form-group">
                <label>Chủ đề</label>
                <input type="text" value="@ViewBag.TopicName (@ViewBag.LanguageName)" class="form-control" disabled readonly />
            </div>
            <div class="form-group">
                <label asp-for="Title">Tiêu đề bài học</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Mô tả</label>
                <textarea asp-for="Description" id="description-editor" class="form-control ckeditor"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Content">Nội dung bài học</label>
                <textarea asp-for="Content" id="content-editor" class="form-control ckeditor"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-dark">Lưu</button>
            <a asp-area="Admin"
               asp-controller="Lesson"
               asp-action="Index"
               asp-route-topicId="@Model.TopicId"
               class="btn">
                Quay lại
            </a>
        </form>
    </div>
</section>
@section Scripts {
    <script src="~/lib/ckeditor5/ckeditor.js"></script>
    <script>
        document.querySelectorAll('.ckeditor').forEach(element => {

        ClassicEditor.create(element, {
                toolbar: ["undo","redo","|","heading","|","bold","italic","|","fontSize","fontFamily","fontColor","fontBackgroundColor","|","bulletedList","numberedList"]
            })
            .catch(error => {
                console.error(error);
            });
    });
    </script>
}


