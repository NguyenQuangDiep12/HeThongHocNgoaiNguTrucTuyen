@using System.Security.Claims
@using System.Text.RegularExpressions;
@functions {
    public string GetPreview(string? content, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return "";
        }
        var text = Regex.Replace(content, "<.*?>", string.Empty);
        text = Regex.Replace(text, @"\s+", " ").Trim();
        if (text.Length > maxLength)
        {
            return text.Substring(0, maxLength) + "...";
        }
        return text;
    }
}

<div class="user-menu">
    <button type="button"
            class="user-icon"
            id="userMenuButton">
        <i class="fa fa-user-circle-o" aria-hidden="true"></i>
    </button>
    <div class="user-dropdown" id="userDropdown">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="user-info">
                <!--Context tuong ung voi HttpContext dai dien cho request response cua he thong-->
                <span>@GetPreview(Context.User.FindFirst(ClaimTypes.Name).Value, 20)</span>
            </div>
            @if (User.FindFirst(ClaimTypes.Role).Value == "ADMIN")
            {
                <a asp-area="Admin" asp-controller="Language" asp-action="Index">Trang quản trị</a>
            }
            <form class="form-logout"
                  asp-controller="Auth"
                  asp-action="Logout"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit">Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-controller="Auth"
               asp-action="Login">
                Đăng nhập
            </a>
            <a asp-controller="Auth"
               asp-action="Register">
                Đăng ký
            </a>
        }
    </div>
</div>