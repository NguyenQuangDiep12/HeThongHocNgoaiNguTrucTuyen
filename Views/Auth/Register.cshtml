@model HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.RegisterRequest

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - Hệ thống học ngoại ngữ trực tuyến</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <!-- Header Logo & Name -->
            <div class="brand-header">
                <div class="logo-box">
                    <img src="~/image/Logo.png" alt="English Pathway Logo">
                </div>
                <h2 class="brand-title">Hệ thống học ngoại ngữ trực tuyến</h2>
            </div>

            <!-- Title & Subtitle -->
            <div class="auth-header">
                <h1 class="auth-title">Đăng Ký</h1>
                <p class="auth-subtitle">Đăng ký để sử dụng hệ thống</p>
            </div>

            @if (TempData["RegisterSuccess"] != null)
            {
                <div class="register-success" style="font: bold; color: dodgerblue;">
                    <span>@TempData["RegisterSuccess"]</span>
                </div>                
            }
            <div asp-validation-summary="ModelOnly" class="error-alert"></div>

            <!-- Form Đăng Ký -->
            <form asp-controller="Auth" asp-action="Register" method="post" id="registerForm" class="auth-form">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="regEmail">FullName:</label>
                    <input type="text" id="regFullName" asp-for="FullName" placeholder="Nhập họ và tên của bạn...">
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="regEmail">Email:</label>
                    <input type="email" id="regEmail" asp-for="Email" placeholder="Nhập email của bạn...">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="regPassword">Mật khẩu:</label>
                    <input type="password" id="regPassword" asp-for="Password" placeholder="Nhập mật khẩu của bạn...">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Nhập lại mật khẩu:</label>
                    <input type="password" id="confirmPassword" asp-for="ConfirmPassword" placeholder="Nhập lại mật khẩu của bạn...">
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="submitBtn" class="btn-primary">
                    <span class="btn-text">Đăng Ký</span>
                    <span class="btn-spinner hidden"></span>
                </button>
            </form>

            <!-- Footer Switch -->
            <div class="auth-footer">
                <span>Đã có tài khoản?</span>
                <a asp-controller="Auth" asp-action="Login" class="btn-outline">Đăng nhập</a>
            </div>
        </div>
    </div>
    <script>

    </script>
</body>
</html>