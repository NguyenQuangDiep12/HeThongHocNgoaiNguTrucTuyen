@model HeThongHocNgoaiNguTrucTuyen.Dtos.Requests.LoginRequest

@{
    Layout = null; // vo hieu hoa khung layout chung
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Hệ thống học ngoại ngữ trực tuyến</title>
    <link rel="stylesheet" href="~/css/auth.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"/>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <!-- Header Logo & Name -->
            <div class="brand-header">
                <div class="logo-box">
                    <img src="~/image/Logo.png" alt="English Pathway Logo">
                </div>
                <h2 class="brand-title">Hệ thống học ngoại ngữ trực tuyến</h2>
            </div>

            <!-- Title & Subtitle -->
            <div class="auth-header">
                <h1 class="auth-title">Đăng nhập</h1>
                <p class="auth-subtitle">Đăng nhập để sử dụng hệ thống</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="error-alert"></div>

            <!-- Form Đăng Nhập -->
            <form asp-controller="Auth" asp-action="Login" method="post" id="loginForm" class="auth-form">
                
                <!-- Cookie duoc tao ra de tranh form duoc gui tu mot trang khac den he thong ,duoi cookie .AspNetCore.Antiforgery.MaChuoiBam-->
                <!-- Chong tan cong CSRF -->
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" id="email" asp-for="Email" placeholder="Nhập email của bạn...">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="password">Mật khẩu:</label>
                    <input type="password" id="password" asp-for="Password" placeholder="Nhập mật khẩu của bạn...">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-remember">
                    <input type="checkbox" id="remember" asp-for="RememberMe">
                    <label for="remember">Ghi nhớ đăng nhập</label>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="submitBtn" class="btn-primary">
                    <span class="btn-text">Đăng nhập</span>
                    <span class="btn-spinner hidden"></span>
                </button>
            </form>

            <!-- Footer Switch -->
            <div class="auth-footer">
                <span>Chưa có tài khoản?</span>
                <a asp-controller="Auth" asp-action="Register" class="btn-outline">Đăng ký</a>
            </div>
        </div>
    </div>
    <script>

    </script>
</body>
</html>